{
  "name": "copilot-chat-kit",
  "version": "1.0.0",
  "private": true,
  "description": "Provider-neutral building blocks shared, as a git submodule, by the Copilot Chat provider extensions.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('out',{recursive:true,force:true})\"",
    "compile": "npm run clean && tsc -p ./",
    "test": "npm run compile && node --test \"out/**/*.test.js\"",
    "check": "npm test",
    "changeset": "changeset",
    "version": "changeset version && npm install --package-lock-only --ignore-scripts"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "24.19.2",
    "@types/vscode": "^1.125.0",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/grikomsn/copilot-chat-kit.git"
  },
  "homepage": "https://github.com/grikomsn/copilot-chat-kit#readme",
  "bugs": {
    "url": "https://github.com/grikomsn/copilot-chat-kit/issues"
  }
}
